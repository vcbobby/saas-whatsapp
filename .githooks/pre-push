#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    echo "✖ Push directo a main bloqueado."
    echo "  Crea una rama, súbela y abre una solicitud de integración (PR) en GitHub."
    echo "  Solo para el primer push del proyecto: ALLOW_MAIN_PUSH=1 git push -u origin main"
    exit 1
  fi
done
