# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local ni pegues valores reales en este archivo.

# local | staging | production
APP_ENV=local
APP_URL=http://localhost:3000

# Se usarán a partir del Paso 4
DATABASE_URL=postgresql://app:cambia-esto@127.0.0.1:5432/saas
REDIS_URL=redis://127.0.0.1:6379

# Se agregarán en los pasos 6 y 9:
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# GEMINI_API_KEY=

# Redis (Paso 7): lo genera scripts/gen-local-env.sh
REDIS_PASSWORD=
