{
  "name": "saas-whatsapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:up": "docker compose --env-file .env.local up -d db redis",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-super-admin.mjs",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file=.env.local src/worker/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "db:extensions": "docker compose --env-file .env.local exec -T db sh -c 'psql -v ON_ERROR_STOP=1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -c \"CREATE EXTENSION IF NOT EXISTS vector\"'",
    "kb:model": "tsx --env-file=.env.local scripts/kb-model.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "6.3.9",
    "ioredis": "6.0.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "tsx": "4.23.14",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
